# Application environment and HTTP server settings.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Minimum severity of application logs.
LOG_LEVEL=info

# Frontend origin allowed to make credentialed cross-origin requests.
CLIENT_ORIGIN=http://localhost:3001

# PostgreSQL connection used by the API and readiness probe.
DATABASE_URL=postgresql://user:password@localhost:5432/nerdos

# Redis connection used for rate limiting and readiness; TLS and credentials are required.
REDIS_URL=rediss://user:password@localhost:6379
# Optional CA certificate for a private Redis certificate authority; use \n for line breaks.
# REDIS_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Neon Auth service URL and secret used to sign session data cookies (at least 32 characters).
NEON_AUTH_BASE_URL=https://your-project.neonauth.example
NEON_AUTH_COOKIE_SECRET=replace-with-a-secure-secret-at-least-32-characters
